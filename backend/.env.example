# Copy this file to .env and fill in real values. Never commit .env.
PORT=4477
DB_PATH=./data/kage.db

# BotFather token for Kage's own dedicated bot (not shared with PRM).
TELEGRAM_BOT_TOKEN=
# Moe's personal chat id (the bot sends reminders only here).
TELEGRAM_CHAT_ID=

# How often the scheduler checks for due alerts, in seconds.
SCHEDULER_INTERVAL_SECONDS=30
