# Copy this file to .env and fill in real values. Never commit .env.
PORT=4477
DB_PATH=./data/kage.db

# Token of the Telegram bot that delivers the reminders (from @BotFather).
TELEGRAM_BOT_TOKEN=
# Fallback chat: reminders of LEGACY_OWNER_USERNAME (or not yet owned) go here
# when that user has no Telegram chat set in the accounts service.
TELEGRAM_CHAT_ID=

# Shared accounts service (see the accounts project). Same token as its SERVICE_TOKEN.
ACCOUNTS_URL=http://accounts:4600
ACCOUNTS_SERVICE_TOKEN=
# Reminders created before accounts existed are given to this user at their first login.
LEGACY_OWNER_USERNAME=
# Set to false only for local development over plain http.
COOKIE_SECURE=true

# How often the scheduler checks for due alerts, in seconds.
SCHEDULER_INTERVAL_SECONDS=30

# Time zone for alert times worked out on the server (Siri presets) and for
# the times shown in Telegram messages, e.g. Europe/Madrid. Defaults to UTC.
TZ=
