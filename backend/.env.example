# Copy this file to .env and fill in real values. Never commit .env.
PORT=4477
DB_PATH=./data/kage.db

# Token of the Telegram bot that delivers the reminders (from @BotFather).
TELEGRAM_BOT_TOKEN=
# Chat id that receives the reminders (the bot sends only here).
TELEGRAM_CHAT_ID=

# How often the scheduler checks for due alerts, in seconds.
SCHEDULER_INTERVAL_SECONDS=30
